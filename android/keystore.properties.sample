# Copy to keystore.properties (gitignored) to sign release builds locally.
# Alternatively set HELIX_KEYSTORE_FILE / HELIX_KEYSTORE_PASSWORD /
# HELIX_KEY_ALIAS / HELIX_KEY_PASSWORD as environment variables in CI.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore helix-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias helix
storeFile=helix-release.jks
storePassword=CHANGE_ME
keyAlias=helix
keyPassword=CHANGE_ME

<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Never back up private browsing data. All SharedPreferences (tabs,
         site permissions, billing, default prefs) are excluded wholesale. -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude the Room database (bookmarks + history) and its SQLite
         sidecar files (WAL/SHM/journal). DB name from AppDatabase.kt:
         "helix_browser.db". -->
    <exclude domain="database" path="helix_browser.db" />
    <exclude domain="database" path="helix_browser.db-wal" />
    <exclude domain="database" path="helix_browser.db-shm" />
    <exclude domain="database" path="helix_browser.db-journal" />
</full-backup-content>

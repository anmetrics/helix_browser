<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up private browsing data to the cloud. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="helix_browser.db" />
        <exclude domain="database" path="helix_browser.db-wal" />
        <exclude domain="database" path="helix_browser.db-shm" />
        <exclude domain="database" path="helix_browser.db-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- Also exclude private browsing data from device-to-device transfer. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="helix_browser.db" />
        <exclude domain="database" path="helix_browser.db-wal" />
        <exclude domain="database" path="helix_browser.db-shm" />
        <exclude domain="database" path="helix_browser.db-journal" />
    </device-transfer>
</data-extraction-rules>
